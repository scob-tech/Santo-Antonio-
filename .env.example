# ==========================================================================
#  scobtech · Atendimento WhatsApp + IA — variáveis de ambiente
#  Copie este arquivo para ".env" (local) OU cole cada chave no painel
#  "Variables" do Railway. NUNCA suba o .env pro GitHub (já está no .gitignore).
# ==========================================================================

# --- Banco de dados -------------------------------------------------------
# No Railway: adicione o plugin PostgreSQL e ele cria essa variável sozinho.
# Local: aponte pro seu Postgres. Se ficar vazio, o sistema sobe em modo demo
# (sem banco) só pra você ver o painel funcionando.
DATABASE_URL=

# --- WhatsApp Cloud API (Meta) --------------------------------------------
# Você preenche isso depois que o cadastro na Meta destravar e o número de
# teste sair. Até lá pode deixar em branco — o resto do sistema roda.
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# ID da conta do WhatsApp Business (WABA). Fica na tela "Configuração da API"
# da Meta, como "Identificação da conta do WhatsApp Business". Com ele, o
# sistema se inscreve sozinho pra receber as mensagens do número.
WABA_ID=
# Token que VOCÊ inventa. Cole o MESMO valor no painel da Meta ao configurar
# o webhook (campo "Verify token").
VERIFY_TOKEN=troque-por-uma-senha-sua

# --- IA (LLM) -------------------------------------------------------------
# Escolha um provedor: "anthropic" (Claude) ou "openai". Cole a chave do
# provedor escolhido. Sem chave, a IA entra em modo simulado (respostas
# de exemplo) — o sistema não quebra.
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Opcional: modelo. Deixe em branco pra usar o padrão de cada provedor.
LLM_MODEL=

# --- App ------------------------------------------------------------------
# O Railway injeta PORT sozinho. Local, usa 3000.
PORT=3000
# Fuso pros relatórios/curadoria (padrão São Paulo).
TZ=America/Sao_Paulo
# Senha única de acesso ao painel na Fase 1 (simples, pra demonstração).
# Depois trocamos por login por usuário de verdade.
PAINEL_SENHA=dandy2026
